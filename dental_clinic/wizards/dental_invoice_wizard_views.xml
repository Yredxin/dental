<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_invoice_wizard_form" model="ir.ui.view">
        <field name="name">dental.invoice.wizard.form</field>
        <field name="model">dental.invoice.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="plan_id" readonly="1"/>
                    <field name="patient_id" readonly="1"/>
                    <field name="invoice_date"/>
                    <field name="journal_id"/>
                </group>
                <field name="line_ids">
                    <list>
                        <field name="treatment_id"/>
                        <field name="tooth_id"/>
                        <field name="quantity"/>
                        <field name="price_unit"/>
                        <field name="discount"/>
                        <field name="subtotal"/>
                    </list>
                </field>
                <footer>
                    <button string="Create Invoice" type="object" name="action_create_invoice"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
