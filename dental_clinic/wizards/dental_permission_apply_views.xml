<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dental_permission_apply_view_form" model="ir.ui.view">
        <field name="name">dental.permission.apply.form</field>
        <field name="model">dental.permission.apply</field>
        <field name="arch" type="xml">
            <form string="Apply Dental Permission Profile">
                <group>
                    <field name="user_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="profile_id" options="{'no_create': True}"/>
                </group>
                <group string="Dental Capabilities">
                    <field name="patient_level"/>
                    <field name="appointment_level"/>
                    <field name="clinical_level"/>
                    <field name="employee_level"/>
                    <field name="configuration_level"/>
                </group>
                <p class="text-muted">This replaces only Dental capabilities. Other Odoo permissions are preserved.</p>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="dental_permission_apply_action" model="ir.actions.act_window">
        <field name="name">Apply Dental Permission Profile</field>
        <field name="res_model">dental.permission.apply</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
