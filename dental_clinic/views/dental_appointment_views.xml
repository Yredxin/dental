<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_appointment_tree" model="ir.ui.view">
        <field name="name">dental.appointment.tree</field>
        <field name="model">dental.appointment</field>
        <field name="arch" type="xml">
            <list string="Appointments"
                  decoration-info="state=='confirmed'"
                  decoration-success="state=='done'"
                  decoration-warning="state=='checked_in'"
                  decoration-muted="state in ('cancel','no_show')">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="practitioner_id"/>
                <field name="room_id"/>
                <field name="start"/>
                <field name="stop"/>
                <field name="duration" widget="float_time"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_dental_appointment_form" model="ir.ui.view">
        <field name="name">dental.appointment.form</field>
        <field name="model">dental.appointment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_check_in" type="object" string="Check-In"
                            invisible="state != 'confirmed'"/>
                    <button name="action_done" type="object" string="Mark Done"
                            class="btn-primary" invisible="state not in ('confirmed','checked_in')"/>
                    <button name="action_no_show" type="object" string="No-Show"
                            invisible="state not in ('confirmed','checked_in')"/>
                    <button name="action_send_reminder" type="object" string="Send Reminder"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancel','done')"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,checked_in,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/><h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="practitioner_id"/>
                            <field name="room_id"/>
                            <field name="plan_id"/>
                        </group>
                        <group>
                            <field name="start"/>
                            <field name="stop"/>
                            <field name="duration" widget="float_time"/>
                            <field name="allday"/>
                        </group>
                    </group>
                    <field name="treatment_ids" widget="many2many_tags"/>
                    <notebook>
                        <page string="Reason"><field name="reason"/></page>
                        <page string="Notes"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dental_appointment_calendar" model="ir.ui.view">
        <field name="name">dental.appointment.calendar</field>
        <field name="model">dental.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointments"
                      date_start="start" date_stop="stop"
                      color="practitioner_id" mode="week" quick_create="0">
                <field name="patient_id"/>
                <field name="practitioner_id" filters="1"/>
                <field name="room_id" filters="1"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_dental_appointment_search" model="ir.ui.view">
        <field name="name">dental.appointment.search</field>
        <field name="model">dental.appointment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="practitioner_id"/>
                <filter name="today" string="Today"
                        domain="[('start','&gt;=',context_today().strftime('%Y-%m-%d 00:00:00')),
                                 ('start','&lt;=',context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter name="upcoming" string="Upcoming"
                        domain="[('start','&gt;=',context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <group>
                    <filter name="group_pract" string="Practitioner" context="{'group_by':'practitioner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_room" string="Room" context="{'group_by':'room_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dental_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">dental.appointment</field>
        <field name="view_mode">list,form,calendar</field>
    </record>

    <record id="action_dental_appointment_calendar" model="ir.actions.act_window">
        <field name="name">Calendar</field>
        <field name="res_model">dental.appointment</field>
        <field name="view_mode">calendar,list,form</field>
    </record>
</odoo>
