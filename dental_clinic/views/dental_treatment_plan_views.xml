<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_treatment_plan_tree" model="ir.ui.view">
        <field name="name">dental.treatment.plan.tree</field>
        <field name="model">dental.treatment.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="practitioner_id"/>
                <field name="date"/>
                <field name="total_amount"/>
                <field name="invoiced_amount" groups="account.group_account_invoice,account.group_account_readonly"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_dental_treatment_plan_form" model="ir.ui.view">
        <field name="name">dental.treatment.plan.form</field>
        <field name="model">dental.treatment.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" groups="dental_clinic.group_dental_clinical_write" type="object" string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start" groups="dental_clinic.group_dental_clinical_write" type="object" string="Start"
                            invisible="state != 'confirmed'"/>
                    <button name="action_done" groups="dental_clinic.group_dental_clinical_write" type="object" string="Done" class="btn-primary"
                            invisible="state not in ('confirmed','in_progress')"/>
                    <div groups="dental_clinic.group_dental_configuration_write">
                        <button name="action_create_invoice" groups="account.group_account_invoice" type="object" string="Create Invoice"
                            invisible="state == 'cancel'"/>
                    </div>
                    <button name="action_cancel" groups="dental_clinic.group_dental_clinical_write" type="object" string="Cancel"
                            invisible="state in ('cancel','done')"/>
                    <button name="action_draft" groups="dental_clinic.group_dental_clinical_write" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" groups="dental_clinic.group_dental_configuration_write">
                        <button name="action_view_invoices" groups="account.group_account_invoice,account.group_account_readonly" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="practitioner_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="expected_end_date"/>
                            <field name="total_amount" widget="monetary"/>
                            <field name="invoiced_amount" groups="account.group_account_invoice,account.group_account_readonly" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Treatments">
                            <field name="line_ids" context="{'default_practitioner_id': practitioner_id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="treatment_id"/>
                                    <field name="tooth_id" domain="[('patient_id','=',parent.patient_id)]"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="discount"/>
                                    <field name="subtotal" sum="Total"/>
                                    <field name="scheduled_date"/>
                                    <field name="state"/>
                                    <field name="invoiced"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_dental_treatment_plan" model="ir.actions.act_window">
        <field name="name">Treatment Plans</field>
        <field name="res_model">dental.treatment.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
