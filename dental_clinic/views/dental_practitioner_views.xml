<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_practitioner_tree" model="ir.ui.view">
        <field name="name">dental.practitioner.tree</field>
        <field name="model">dental.practitioner</field>
        <field name="arch" type="xml">
            <list string="Practitioners">
                <field name="name"/>
                <field name="speciality"/>
                <field name="license_number"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="appointment_count"/>
            </list>
        </field>
    </record>
    <record id="view_dental_practitioner_form" model="ir.ui.view">
        <field name="name">dental.practitioner.form</field>
        <field name="model">dental.practitioner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/><h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="speciality"/>
                            <field name="license_number"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_dental_practitioner" model="ir.actions.act_window">
        <field name="name">Practitioners</field>
        <field name="res_model">dental.practitioner</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
