<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_dental_patient_card">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Patient Card</h2>
                        <table class="table table-sm">
                            <tr><th>Code</th><td><span t-field="o.code"/></td></tr>
                            <tr><th>Name</th><td><span t-field="o.name"/></td></tr>
                            <tr><th>Date of Birth</th><td><span t-field="o.birth_date"/></td></tr>
                            <tr><th>Gender</th><td><span t-field="o.gender"/></td></tr>
                            <tr><th>Blood Type</th><td><span t-field="o.blood_type"/></td></tr>
                            <tr><th>Phone</th><td><span t-field="o.phone"/></td></tr>
                            <tr><th>Mobile</th><td><span t-field="o.mobile"/></td></tr>
                            <tr><th>Email</th><td><span t-field="o.email"/></td></tr>
                            <tr><th>Address</th><td>
                                <span t-field="o.street"/>, <span t-field="o.city"/>
                                <span t-field="o.zip"/> <span t-field="o.country_id.name"/></td></tr>
                            <tr><th>Allergies</th><td><span t-field="o.allergies"/></td></tr>
                            <tr><th>Chronic Diseases</th><td><span t-field="o.chronic_diseases"/></td></tr>
                            <tr><th>Medications</th><td><span t-field="o.current_medications"/></td></tr>
                            <tr><th>Emergency</th>
                                <td><span t-field="o.emergency_name"/>
                                    (<span t-field="o.emergency_relation"/>) -
                                    <span t-field="o.emergency_phone"/></td></tr>
                        </table>
                        <h3 class="mt16">Odontogram</h3>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr><th>#</th><th>Tooth</th><th>Quadrant</th>
                                    <th>Condition</th><th>Surface</th><th>Last Tx</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.tooth_ids" t-as="t">
                                    <td><span t-field="t.tooth_number"/></td>
                                    <td><span t-field="t.name"/></td>
                                    <td><span t-field="t.quadrant"/></td>
                                    <td><span t-field="t.condition"/></td>
                                    <td><span t-field="t.surface"/></td>
                                    <td><span t-field="t.last_treatment_date"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
