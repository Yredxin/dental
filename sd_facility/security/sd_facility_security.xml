<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_facility" model="ir.module.category">
        <field name="name">Facilities</field>
        <field name="sequence">30</field>
    </record>
    <record id="privilege_facility" model="res.groups.privilege">
        <field name="name">Facility Management</field>
        <field name="category_id" ref="module_category_facility"/>
    </record>
    <record id="sd_facility_group_read" model="res.groups">
        <field name="name">Facility Read</field>
        <field name="privilege_id" ref="privilege_facility"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="sd_facility_group_manager" model="res.groups">
        <field name="name">Facility Manager</field>
        <field name="privilege_id" ref="privilege_facility"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('sd_facility_group_read'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('sd_facility_group_manager'))]"/>
    </record>
</odoo>
