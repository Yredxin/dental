<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sd_facility_station_view_list" model="ir.ui.view">
        <field name="name">sd.facility.station.list</field>
        <field name="model">sd.facility.station</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="space_id"/>
                <field name="resource_calendar_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="sd_facility_station_view_form" model="ir.ui.view">
        <field name="name">sd.facility.station.form</field>
        <field name="model">sd.facility.station</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="company_id" readonly="id" groups="base.group_multi_company"/>
                            <field name="space_id" domain="[('type', '=', 'area'), ('company_id', '=', company_id)]"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="resource_calendar_id" domain="[('company_id', 'in', [False, company_id])]" options="{'no_create': True}"/>
                            <field name="tz"/>
                            <field name="resource_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sd_facility_station_view_search" model="ir.ui.view">
        <field name="name">sd.facility.station.search</field>
        <field name="model">sd.facility.station</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="space_id"/>
                <field name="resource_id"/>
                <field name="resource_calendar_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_area" string="Area" context="{'group_by': 'space_id'}"/>
                <filter name="group_calendar" string="Working Hours" context="{'group_by': 'resource_calendar_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>
    <record id="sd_facility_station_action" model="ir.actions.act_window">
        <field name="name">Workstations</field>
        <field name="res_model">sd.facility.station</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sd_facility_station_view_search"/>
    </record>
</odoo>
