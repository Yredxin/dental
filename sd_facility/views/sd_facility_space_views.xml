<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sd_facility_space_view_list" model="ir.ui.view">
        <field name="name">sd.facility.space.list</field>
        <field name="model">sd.facility.space</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="type"/>
                <field name="parent_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="sd_facility_space_view_form" model="ir.ui.view">
        <field name="name">sd.facility.space.form</field>
        <field name="model">sd.facility.space</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="type"/>
                            <field name="parent_id" invisible="type == 'facility'" required="type != 'facility'"
                                domain="[('company_id', '=', company_id), ('type', 'in', ['facility'] if type == 'floor' else ['floor', 'area'])]"/>
                            <field name="complete_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id" readonly="id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="children" string="Direct Child Spaces">
                            <field name="child_ids" readonly="1">
                                <list create="0" delete="0"><field name="name"/><field name="type"/><field name="active"/></list>
                            </field>
                        </page>
                        <page name="stations" string="Direct Workstations" invisible="type != 'area'">
                            <field name="station_ids" readonly="1">
                                <list create="0" delete="0"><field name="name"/><field name="code"/><field name="active"/></list>
                            </field>
                        </page>
                        <page name="description" string="Description"><field name="description"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sd_facility_space_view_search" model="ir.ui.view">
        <field name="name">sd.facility.space.search</field>
        <field name="model">sd.facility.space</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="parent_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="facility" string="Facilities" domain="[('type', '=', 'facility')]"/>
                <filter name="floor" string="Floors" domain="[('type', '=', 'floor')]"/>
                <filter name="area" string="Areas" domain="[('type', '=', 'area')]"/>
                <separator/>
                <filter name="group_parent" string="Parent Space" context="{'group_by': 'parent_id'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'type'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>
    <record id="sd_facility_space_action_facility" model="ir.actions.act_window">
        <field name="name">Facilities</field>
        <field name="res_model">sd.facility.space</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type', '=', 'facility')]</field>
        <field name="context">{'default_type': 'facility'}</field>
        <field name="search_view_id" ref="sd_facility_space_view_search"/>
    </record>
    <record id="sd_facility_space_action_floor" model="ir.actions.act_window">
        <field name="name">Floors</field>
        <field name="res_model">sd.facility.space</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type', '=', 'floor')]</field>
        <field name="context">{'default_type': 'floor'}</field>
        <field name="search_view_id" ref="sd_facility_space_view_search"/>
    </record>
    <record id="sd_facility_space_action_area" model="ir.actions.act_window">
        <field name="name">Areas</field>
        <field name="res_model">sd.facility.space</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type', '=', 'area')]</field>
        <field name="context">{'default_type': 'area'}</field>
        <field name="search_view_id" ref="sd_facility_space_view_search"/>
    </record>
</odoo>
